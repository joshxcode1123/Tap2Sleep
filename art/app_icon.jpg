  <!-- Center Filled Button Circle (Slightly larger: radius 13.5dp) -->
  <path fill="#FFFFFF" d="M 54,40.5 A 13.5,13.5 0 1 1 54,67.5 A 13.5,13.5 0 1 1 54,40.5 Z" />

  <!-- Semi-Oval Finger Coming from Bottom-Right to Press Center Circle -->
  <g transform="rotate(-45, 54, 54)">
    <!-- Knockout Cutout for Clean Material Separation -->
    <path fill="#111827" d="M 42,60 v 44 h 24 v -44 a 12,12 0 0 0 -24,0 z" />

    <!-- Finger Semi-Oval Capsule (Wider Material 3 Shape) -->
    <path fill="#D3E3FD" d="M 45,62 v 42 h 18 v -42 a 9,9 0 0 0 -18,0 z" />

    <!-- Fingertip Touch Contact Accent -->
    <path fill="#FFFFFF" fill-opacity="0.65" d="M 49,59 a 5,4 0 0 1 10,0 a 5,2 0 0 1 -10,0 z" />
  </g>
</svg>
